; Pure numeric-input state and suppression policy checks; never installs a hook.
; Called by the main --audit-selftest runner after including id_capture.ahk.
IDCapture_RunRegression() {
    AuditAssert("ID capture timeout defaults to 3 seconds", IDCapture_NormalizeTimeout("") = 3 && IDCapture_NormalizeTimeout("bad") = 3)
    AuditAssert("ID capture timeout clamps to 1..15", IDCapture_NormalizeTimeout(0) = 1 && IDCapture_NormalizeTimeout(20) = 15)
    state := IDCapture_NewState(7, 123, 3, 100, "profile")
    AuditAssert("ID capture deadline is fixed from start", state.Deadline = 3100 && state.Value = "" && state.Pending = "")
    AuditAssert("ID capture accepts digits and preserves leading zero", IDCapture_Reduce(state, "digit", "0") && IDCapture_Reduce(state, "digit", "7") && state.Value == "07")
    AuditAssert("ID capture ignores non-digit text", !IDCapture_Reduce(state, "digit", "a") && state.Value == "07")
    IDCapture_Reduce(state, "erase")
    AuditAssert("ID capture Backspace removes exactly one digit", state.Value == "0")
    IDCapture_Reduce(state, "erase"), IDCapture_Reduce(state, "erase")
    AuditAssert("ID capture Backspace on empty remains empty", state.Value == "")
    Loop, 21
        IDCapture_Reduce(state, "digit", "9")
    AuditAssert("ID capture caps at 20 digits without numeric rounding", StrLen(state.Value) = 20 && state.Value == "99999999999999999999" && state.LimitHit)
    AuditAssert("ID capture validation preserves large masks", IDCapture_IsValid("12345678901234567890") && IDCapture_IsValid("00123"))
    AuditAssert("ID capture invalid or empty strings cannot commit", !IDCapture_IsValid("") && !IDCapture_IsValid("123x") && !IDCapture_IsValid("123456789012345678901"))
    IDCapture_Reduce(state, "cancel")
    AuditAssert("ID capture cancellation freezes the pending value", state.Pending = "cancel" && !IDCapture_Reduce(state, "digit", "4"))
    state := IDCapture_NewState(7, 123, 3, 100)
    AuditAssert("ID capture top-row and numpad digit decode", IDCapture_DigitForKey(0x30) == "0" && IDCapture_DigitForKey(0x69) == "9")
    AuditAssert("ID capture modified and non-digit keys decode as empty", IDCapture_DigitForKey(0x31, 4) == "" && IDCapture_DigitForKey(0x41) == "")
    AuditAssert("ID capture plain digit down is suppressed", IDCapture_HandleKey(state, 0x31, 0, 0, 1, 0, 101) = 1 && state.Value == "1")
    AuditAssert("ID capture owned digit up is suppressed and released", IDCapture_HandleKey(state, 0x31, 0, 0x80, 0, 1, 102) = 1 && !state.OwnedKeys.HasKey(0x31))
    AuditAssert("ID capture other letters pass through", IDCapture_HandleKey(state, 0x57, 0, 0, 1, 0, 103) = 0 && state.Value == "1")
    IDCapture_HandleKey(state, 0xA2, 0, 0, 1, 0, 104)
    AuditAssert("ID capture Ctrl+digit shortcut passes without append", IDCapture_HandleKey(state, 0x32, 0, 0, 1, 0, 105) = 0 && state.Value == "1" && state.ModifierMask = 4)
    IDCapture_HandleKey(state, 0xA2, 0, 0x80, 0, 1, 106)
    AuditAssert("ID capture modifier release restores plain digits", IDCapture_HandleKey(state, 0x62, 0, 0, 1, 0, 107) = 1 && state.Value == "12")
    AuditAssert("ID capture injected digits are ignored and pass through", IDCapture_HandleKey(state, 0x33, 0, 0x10, 1, 0, 108) = 0 && state.Value == "12")
    IDCapture_HandleKey(state, 0x62, 0, 0x80, 0, 1, 109)
    AuditAssert("ID capture Backspace down is suppressed", IDCapture_HandleKey(state, 8, 0, 0, 1, 0, 110) = 1 && state.Value == "1")
    IDCapture_HandleKey(state, 8, 0, 0x80, 0, 1, 111)
    AuditAssert("ID capture Enter suppresses and schedules confirmation", IDCapture_HandleKey(state, 0xD, 0, 0, 1, 0, 112) = 1 && state.Pending = "confirm")
    AuditAssert("ID capture pending confirmation blocks further collection", IDCapture_HandleKey(state, 0x34, 0, 0, 1, 0, 113) = 0 && state.Value == "1")
    state := IDCapture_NewState(7, 123, 3, 100)
    state.InitialKeys[0x31] := 1
    AuditAssert("ID capture held activation digit repeats pass without append", IDCapture_HandleKey(state, 0x31, 0, 0, 1, 0, 101) = 0 && state.Value == "")
    AuditAssert("ID capture activation key release clears initial-key guard", IDCapture_HandleKey(state, 0x31, 0, 0x80, 0, 1, 102) = 0 && state.InitialKeys.Count() = 0)
    AuditAssert("ID capture fresh activation digit can become input", IDCapture_HandleKey(state, 0x31, 0, 0, 1, 0, 103) = 1 && state.Value == "1")
    AuditAssert("ID capture Escape suppresses and schedules cancellation", IDCapture_HandleKey(state, 0x1B, 0, 0, 1, 0, 104) = 1 && state.Pending = "cancel")
    state := IDCapture_NewState(7, 123, 3, 100)
    IDCapture_Reduce(state, "digit", "8")
    AuditAssert("ID capture deadline ends collection without stealing late digit", IDCapture_HandleKey(state, 0x39, 0, 0, 1, 0, 3100) = 0 && state.Pending = "confirm" && state.Value == "8")
    state := IDCapture_NewState(7, 123, 3, 100)
    AuditAssert("ID capture chat-open key passes and cancels collection", IDCapture_HandleKey(state, 0x75, 0, 0, 1, 0, 101) = 0 && state.Pending = "cancel")
    AuditAssert("ID capture left/right modifier bits are distinct", IDCapture_ModifierBit(0xA0, 0, 0) = 1 && IDCapture_ModifierBit(0xA1, 0, 0) = 2 && IDCapture_ModifierBit(0x5B, 0, 0) = 64 && IDCapture_ModifierBit(0x5C, 0, 0) = 128)
    AuditAssert("ID capture resolves Alt+digit binding", IDCapture_ActivationVK("!1") = 0x31)
    AuditAssert("ID capture resolves multiple modifier F-key binding", IDCapture_ActivationVK("^!F2") = 0x71)
    AuditAssert("ID capture resolves wildcard/hook numpad binding", IDCapture_ActivationVK("~$*Numpad1") = 0x61)
    AuditAssert("ID capture resolves custom combination suffix", IDCapture_ActivationVK("LCtrl & j") = 0x4A)
    AuditAssert("ID capture resolves combined VK/scan-code binding", IDCapture_ActivationVK("vk31sc002") = 0x31)
    AuditAssert("ID capture resolves qualified modifier and Up suffix", IDCapture_ActivationVK("<^>!F2 Up") = 0x71)
    AuditAssert("ID capture mouse or missing activation cannot leave key guard", IDCapture_ActivationVK("!LButton") = 0 && IDCapture_ActivationVK("") = 0)
    state := IDCapture_NewState(7, 123, 3, 100)
    state.ActivationVK := 0x71, state.ActivationHeld := 1, state.InitialKeys[0x71] := 1
    AuditAssert("ID capture held F2 activation blocks premature confirm", IDCapture_ConfirmationBlocked(state, "confirm") && !IDCapture_ConfirmationBlocked(state, "timeout"))
    AuditAssert("ID capture held F2 repeat passes without clearing guard", IDCapture_HandleKey(state, 0x71, 0, 0, 1, 0, 101) = 0 && state.ActivationHeld)
    IDCapture_HandleKey(state, 0x71, 0, 0x80, 0, 1, 102)
    AuditAssert("ID capture F2 keyup permits intentional second confirmation", !state.ActivationHeld && !state.InitialKeys.HasKey(0x71) && !IDCapture_ConfirmationBlocked(state, "confirm") && IDCapture_HandleKey(state, 0x71, 0, 0, 1, 0, 103) = 0)
    state.InitialKeys[0x35] := 1
    AuditAssert("ID capture unrelated held digit does not block confirmation", !IDCapture_ConfirmationBlocked(state, "confirm"))
    state.ActivationVK := 0x11, state.ActivationHeld := 1, state.InitialKeys[0x11] := 1
    state.ModifierMask := 4
    IDCapture_HandleKey(state, 0xA2, 0, 0x80, 0, 1, 104)
    AuditAssert("ID capture modifier-only activation releases its initial guard", !state.ActivationHeld && !state.InitialKeys.HasKey(0x11) && state.ModifierMask = 0)
}
