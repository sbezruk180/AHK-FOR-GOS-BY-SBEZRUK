LawSearch_GetResultPartText(item, part, ByRef partCount)
{
    global LawSearchDisplayPageCache
    layout := LawSearch_GetResultLayout(item)
    key := layout.ContentW . "|" . layout.BodyH . "|" . A_ScreenDPI . "|" . layout.DisplayPrefix
    if (!IsObject(LawSearchDisplayPageCache) || LawSearchDisplayPageCache.Item != item || LawSearchDisplayPageCache.Key != key)
    {
        display := LawSearch_GetItemBodyText(item)
        if (display = "")
            display := LawSearch_GetItemTitle(item)
        pages := LawGui_MeasuredPages(layout.DisplayPrefix . display, layout.ContentW, layout.BodyH, 9)
        LawSearchDisplayPageCache := {Item: item, Key: key, Pages: pages}
    }
    pages := LawSearchDisplayPageCache.Pages
    partCount := Max(1, pages.Length())
    part := Min(partCount, Max(1, Round(part)))
    return pages[part]
}


LawSearch_WrapDisplayText(text, width)
{
    lines := []
    Loop, Parse, text, `n, `r
    {
        LawSearch_WrapLineToArray(A_LoopField, width, lines)
    }
    if (lines.Length() = 0)
        lines.Push("")
    return lines
}

LawSearch_WrapLineToArray(line, width, ByRef lines)
{
    line := Trim(line)
    if (line = "")
    {
        lines.Push("")
        return
    }
    if (StrLen(line) <= width)
    {
        lines.Push(line)
        return
    }

    current := ""
    words := StrSplit(line, A_Space)
    Loop % words.Length()
    {
        word := words[A_Index]
        if (word = "")
            continue
        candidate := current = "" ? word : current . " " . word
        if (StrLen(candidate) <= width)
            current := candidate
        else
        {
            if (current != "")
                lines.Push(current)
            current := word
        }
    }
    if (current != "")
        lines.Push(current)
}

