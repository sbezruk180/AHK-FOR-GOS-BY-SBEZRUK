Helper_CloseChatAfterGui(inputEpoch := 0)
{
    inputEpoch := AutomationEpoch
    ; The configured local hotkey can still be physically held when it fires.
    ; Wait for release before sending Ctrl+A or Escape to the game.
    KeyWait, F
    KeyWait, LControl
    KeyWait, RControl
    KeyWait, LAlt
    KeyWait, RAlt

    SafeSend("{LControl up}{RControl up}{LAlt up}{RAlt up}", "Input", inputEpoch)
    Sleep, 30

    if IsFunc("isInChat")
    {
        chatFn := Func("isInChat")
        if (chatFn.Call() != 1)
            return true
    }

    if IsFunc("ClearBindMenuChatLine")
    {
        clearFn := Func("ClearBindMenuChatLine")
        clearFn.Call(true)
    }
    else
    {
        SafeSend("^a", "Event", inputEpoch)
        Sleep, 30
        SafeSend("{Backspace}", "Event", inputEpoch)
        Sleep, 30
    }

    started := TickNow()
    Loop
    {
        if IsFunc("isInChat")
        {
            chatFn := Func("isInChat")
            if (chatFn.Call() != 1)
                return true
        }

        ; Escape cancels the empty line. Enter and F6 are never used.
        SafeSend("{Esc}", "Event", inputEpoch)
        Sleep, 90

        if (TickNow() - started >= 900)
            break
    }

    if IsFunc("isInChat")
    {
        chatFn := Func("isInChat")
        return chatFn.Call() != 1
    }
    return true
}


LawGui_FormatBody(body, title := "")
{
    marker := "__LAWGUI_CURRENT_PAGE__"
    prefix := LawGui_GetDocPrefixFromTitle(title, page)
    if (prefix != "" && page > 1)
    {
        before := ""
        prevCount := page - 1
        Loop %prevCount%
        {
            fnName := "LawText_" . prefix . A_Index
            if IsFunc(fnName)
            {
                fn := Func(fnName)
                before .= fn.Call() . "`r`n"
            }
        }

        formatted := LawGui_FormatBodyCore(before . marker . "`r`n" . body)
        markerPos := InStr(formatted, marker)
        if (markerPos > 0)
            return Trim(SubStr(formatted, markerPos + StrLen(marker)), "`r`n")
    }

    return LawGui_FormatBodyCore(body)
}

LawGui_GetDocPrefixFromTitle(title, ByRef page)
{
    page := 1
    if (RegExMatch(title, "\(([0-9]+)/[0-9]+\)", m))
        page := m1 + 0

    if (InStr(title, "Внутренний устав"))
        return "vu"
    if (InStr(title, "Федеральное постановление"))
        return "fp"
    if (InStr(title, "Конституция"))
        return "kon"
    if (InStr(title, "О полиции"))
        return "fzop"
    if (InStr(title, "территориях"))
        return "ter"
    if (InStr(title, "Трудовой"))
        return "tk"
    if (InStr(title, "Административный регламент"))
        return "arg"
    if (InStr(title, "Уголовный кодекс") && !InStr(title, "Уголовно-процессуальный"))
        return "uk"
    if (InStr(title, "вертикали власти"))
        return "vv"
    if (InStr(title, "административных правонарушениях"))
        return "koap"
    if (InStr(title, "Правила дорожного движения"))
        return "pdd"
    if (InStr(title, "Об оружии"))
        return "oruzh"
    if (InStr(title, "Уголовно-процессуальный"))
        return "upk"
    return ""
}

LawGui_FormatBodyCore(body)
{
    formatted := ""
    article := ""
    part := ""
    point := ""
    currentLevel := ""
    currentText := ""
    explainActive := 0
    explainSubSeen := 0
    explainAfterList := 0
    explainArticle := ""
    explainPart := ""
    explainPoint := ""
    subListActive := 0
    subListSubSeen := 0
    subListAfterList := 0
    subListPoint := ""
    subListPart := ""
    subListArticle := ""

    Loop, Parse, body, `n, `r
    {
        raw := A_LoopField
        line := Trim(raw)
        if (line = "")
        {
            formatted .= "`r`n"
            continue
        }
        if (line = "__LAWGUI_CURRENT_PAGE__")
        {
            formatted .= line . "`r`n"
            continue
        }

        if (!explainActive && !subListActive && currentLevel = "point" && LawSearch_TextEndsWithColon(currentText) && RegExMatch(line, "^\s*[0-9]+\)\s+"))
        {
            subListActive := 1
            subListSubSeen := 0
            subListAfterList := 0
            subListPoint := point
            subListPart := part
            subListArticle := article
        }

        indent := LawGui_GetIndent(raw)
        kind := ""
        id := ""
        title := ""
        itemBody := ""
        forceSubPoint := ((explainActive && !explainAfterList) || (subListActive && !subListAfterList))

        if (LawSearch_ParseStructureLine(line, kind, id, title, itemBody, article, 0, part, point, forceSubPoint))
        {
            if (kind = "chapter")
            {
                article := ""
                part := ""
                point := ""
                explainActive := 0
                explainSubSeen := 0
                explainAfterList := 0
                subListActive := 0
                subListSubSeen := 0
                subListAfterList := 0
            }
            else if (kind = "article")
            {
                article := id
                part := ""
                point := ""
                explainActive := 0
                explainSubSeen := 0
                explainAfterList := 0
                subListActive := 0
                subListSubSeen := 0
                subListAfterList := 0
            }
            else if (kind = "part")
            {
                part := id
                point := ""
                explainActive := 0
                explainSubSeen := 0
                explainAfterList := 0
                subListActive := 0
                subListSubSeen := 0
                subListAfterList := 0
            }
            else if (kind = "point")
            {
                point := id
                explainActive := 0
                explainSubSeen := 0
                explainAfterList := 0
                subListActive := 0
                subListSubSeen := 0
                subListAfterList := 0
            }
            else if (kind = "subpoint")
            {
                if (explainActive)
                {
                    if (explainArticle != "")
                        article := explainArticle
                    if (explainPart != "")
                        part := explainPart
                    if (explainPoint != "")
                        point := explainPoint
                    explainSubSeen := 1
                }
                if (subListActive)
                {
                    if (subListArticle != "")
                        article := subListArticle
                    if (subListPart != "")
                        part := subListPart
                    if (subListPoint != "")
                        point := subListPoint
                    subListSubSeen := 1
                }
            }

            currentLevel := kind
            currentText := itemBody
            formatted .= indent . LawGui_FormatStructureDisplay(kind, id, title, itemBody) . "`r`n"
            continue
        }

        if (LawSearch_DetectPointExplanation(line, expArticle, expPart, expPoint))
        {
            explainActive := 1
            explainSubSeen := 0
            explainAfterList := 0
            explainArticle := expArticle
            explainPart := expPart
            explainPoint := expPoint
            if (expArticle != "")
                article := expArticle
            if (expPart != "")
                part := expPart
            if (expPoint != "")
                point := expPoint
        }
        else
        {
            if (explainActive && explainSubSeen)
                explainAfterList := 1
            if (subListActive && subListSubSeen)
                subListAfterList := 1
        }

        if (currentLevel != "")
            currentText .= " " . line
        formatted .= raw . "`r`n"
    }

    return RTrim(formatted, "`r`n")
}

LawGui_GetIndent(raw)
{
    if (RegExMatch(raw, "^\s+", m))
        return m
    return ""
}

LawGui_FormatStructureDisplay(kind, id, title, body)
{
    if (kind = "chapter" || kind = "article")
        return title

    if (kind = "part")
        prefix := "Ч. " . id
    else if (kind = "point")
        prefix := "П. " . id
    else if (kind = "subpoint")
        prefix := "ПП. " . id
    else
        prefix := title

    body := Trim(body)
    if (body != "")
        return prefix . ". " . body
    return prefix
}


LawGui_GetLayout(screenWidth := "", screenHeight := "", dpi := "")
{
    if (screenWidth = "")
        screenWidth := A_ScreenWidth
    if (screenHeight = "")
        screenHeight := A_ScreenHeight
    if (dpi = "")
        dpi := A_ScreenDPI
    scale := Max(1, dpi) / 96.0
    screenW := Floor(screenWidth / scale)
    screenH := Floor(screenHeight / scale)
    width := Max(160, Min(900, Max(620, Floor(screenW / 3)), screenW - 16))
    height := Max(100, screenH - 26)
    contentW := Min(650, width - 50)
    if (contentW < 550)
        contentW := width - 24
    fontSize := screenH >= 1300 ? 10 : (screenH < 520 ? 8 : 9)
    return {W: width, H: height, ContentW: contentW, BodyY: 40, BodyH: Max(32, height - 50)
        , FontSize: fontSize, TitleFontSize: fontSize + 1, Scale: scale}
}

LawGui_MeasuredPages(text, logicalWidth, logicalHeight, pointSize := 9)
{
    ; The same Segoe UI font as the static body is measured once per build.
    ; Explicitly wrapped lines also keep long URLs/words inside the overlay.
    pages := []
    scale := A_ScreenDPI / 96.0
    pixelWidth := Max(1, Floor((logicalWidth - 6) * scale))
    pixelHeight := Max(1, Floor((logicalHeight - 8) * scale))
    dc := DllCall("GetDC", "Ptr", 0, "Ptr")
    font := dc ? DllCall("CreateFontA", "Int", -Round(pointSize * A_ScreenDPI / 72)
        , "Int", 0, "Int", 0, "Int", 0, "Int", 400, "UInt", 0, "UInt", 0, "UInt", 0
        , "UInt", 1, "UInt", 0, "UInt", 0, "UInt", 0, "UInt", 0, "AStr", "Segoe UI", "Ptr") : 0
    previous := font ? DllCall("SelectObject", "Ptr", dc, "Ptr", font, "Ptr") : 0
    try
    {
        VarSetCapacity(metrics, 64, 0)
        gotMetrics := dc && font && DllCall("GetTextMetricsW", "Ptr", dc, "Ptr", &metrics)
        lineHeight := gotMetrics ? NumGet(metrics, 0, "Int") : Ceil(pointSize * A_ScreenDPI / 72 * 1.35)
        maxLines := Max(1, Floor(pixelHeight / Max(1, lineHeight)))
        lines := []
        Loop, Parse, text, `n, `r
            LawGui_WrapMeasuredLine(A_LoopField, dc && font ? dc : 0, pixelWidth, lineHeight, lines)
        if (lines.Length() = 0)
            lines.Push("")
        current := ""
        lineCount := 0
        for _, line in lines
        {
            if (lineCount >= maxLines)
            {
                pages.Push(current)
                current := ""
                lineCount := 0
            }
            if (lineCount)
                current .= "`r`n"
            current .= line
            lineCount++
        }
        pages.Push(current)
    }
    finally
    {
        if (previous)
            DllCall("SelectObject", "Ptr", dc, "Ptr", previous)
        if (font)
            DllCall("DeleteObject", "Ptr", font)
        if (dc)
            DllCall("ReleaseDC", "Ptr", 0, "Ptr", dc)
    }
    return pages
}

LawGui_WrapMeasuredLine(line, dc, pixelWidth, lineHeight, ByRef lines)
{
    if (line = "")
    {
        lines.Push("")
        return
    }
    line := StrReplace(line, "`t", "        ")
    remaining := line
    while (remaining != "")
    {
        length := StrLen(remaining)
        count := StrPut(remaining, "UTF-16")
        VarSetCapacity(buffer, count * 2, 0)
        StrPut(remaining, &buffer, count, "UTF-16")
        lo := 1
        hi := length
        fit := 1
        VarSetCapacity(size, 8, 0)
        while (lo <= hi)
        {
            mid := Floor((lo + hi) / 2)
            measured := dc && DllCall("GetTextExtentPoint32W", "Ptr", dc, "Ptr", &buffer, "Int", mid, "Ptr", &size)
            width := measured ? NumGet(size, 0, "Int") : mid * Max(1, lineHeight)
            if (width <= pixelWidth)
            {
                fit := mid
                lo := mid + 1
            }
            else
                hi := mid - 1
        }
        if (fit >= length)
        {
            lines.Push(remaining)
            return
        }
        splitAt := fit
        ; Prefer a word boundary, preserving every character and blank line.
        Loop % fit
        {
            at := fit - A_Index + 1
            char := SubStr(remaining, at, 1)
            if (char = " " || char = "`t")
            {
                splitAt := at
                break
            }
        }
        lines.Push(SubStr(remaining, 1, splitAt))
        remaining := SubStr(remaining, splitAt + 1)
    }
}

LawGui_Show(state, title, body, officialExact := 0, docPrefix := "")
{
    global LawGuiTextColor, LawGuiBgColor, LawGuiTransparency
    if (!state)
    {
        LawGui_Close()
        return
    }
    if (!officialExact)
        body := LawGui_FormatBody(body, title)
    layout := LawGui_GetLayout()
    LawGuiW := layout.W
    LawGuiH := layout.H
    ContentW := layout.ContentW
    BodyY := layout.BodyY
    BodyH := layout.BodyH
    LawBodyFontSize := layout.FontSize
    LawTitleFontSize := layout.TitleFontSize
    UpdateLawGuiColors()
    LawTextColor := LawGuiTextColor = "" ? "FFFFFF" : LawGuiTextColor
    LawBgColor := LawGuiBgColor = "" ? "000000" : LawGuiBgColor
    LawAlpha := LawGuiTransparency = "" ? 222 : LawGuiTransparency
    LawAlpha := Min(235, Max(200, LawAlpha))
    LawAccentColor := LawSearch_GetShellAccentColor()
    LawHeaderTitle := title
    LawHeaderPage := ""
    if (RegExMatch(title, "^(.*) \(([^()]*)\)$", LawTitleMatch))
    {
        LawHeaderTitle := LawTitleMatch1
        LawHeaderPage := LawTitleMatch2
    }
    HeaderPageW := LawHeaderPage = "" ? 0 : 78
    HeaderMapW := (docPrefix = "ter") ? 72 : 0
    HeaderTitleW := Max(40, ContentW - HeaderPageW - HeaderMapW - (HeaderPageW ? 8 : 0) - (HeaderMapW ? 8 : 0))
    HeaderPageX := 10 + HeaderTitleW + 8
    HeaderMapX := 10 + ContentW - HeaderMapW
    LawBorderRight := LawGuiW - 2
    LawBorderBottom := LawGuiH - 2
    Gui, 1:Destroy
    Gui, 1:+LastFound +AlwaysOnTop -Caption +ToolWindow +Border +HwndLawGuiHwnd
    Gui, 1:Color, %LawBgColor%, %LawBgColor%
    Gui, 1:Margin, 10, 6
    Gui, 1:Add, Progress, -Theme x0 y0 w%LawGuiW% h2 Disabled Background%LawBgColor% c%LawAccentColor%, 100
    Gui, 1:Add, Progress, -Theme x0 y%LawBorderBottom% w%LawGuiW% h2 Disabled Background%LawBgColor% c%LawAccentColor%, 100
    Gui, 1:Add, Progress, -Theme x0 y0 w2 h%LawGuiH% Disabled Vertical Background%LawBgColor% c%LawAccentColor%, 100
    Gui, 1:Add, Progress, -Theme x%LawBorderRight% y0 w2 h%LawGuiH% Disabled Vertical Background%LawBgColor% c%LawAccentColor%, 100
    Gui, 1:Font, s%LawTitleFontSize% Bold c%LawTextColor%, Segoe UI
    Gui, 1:Add, Text, x10 y6 w%HeaderTitleW% h24 +0x200 +0x4000 +0x80 BackgroundTrans, %LawHeaderTitle%
    if (LawHeaderPage != "")
    {
        Gui, 1:Font, s%LawBodyFontSize% Bold c%LawAccentColor%, Segoe UI
        Gui, 1:Add, Text, x%HeaderPageX% y6 w%HeaderPageW% h24 +0x200 Right +0x80 BackgroundTrans, %LawHeaderPage%
    }
    if (docPrefix = "ter")
    {
        Gui, 1:Font, s%LawBodyFontSize% Bold c%LawTextColor%, Segoe UI
        Gui, 1:Add, Button, x%HeaderMapX% y7 w%HeaderMapW% h22 gTerritoryMap_ShowCatalog, Карты
    }
    Gui, 1:Add, Progress, -Theme x10 y33 w%ContentW% h1 Disabled Background%LawBgColor% c%LawAccentColor%, 100
    Gui, 1:Font, Norm s%LawBodyFontSize% c%LawTextColor%, Segoe UI
    Gui, 1:Add, Text, x10 y%BodyY% w%ContentW% h%BodyH% +0x80 BackgroundTrans, %body%
    Capture_BeforeShow("1")
    Gui, 1:Show, x5 y8 w%LawGuiW% h%LawGuiH% NoActivate, window.
    WinSet, Transparent, %LawAlpha%, ahk_id %LawGuiHwnd%
    LawSearch_ApplyShellRound(LawGuiHwnd)
}


